/*
	Author Jacob A. Psimos
*/

#include "include/dt-bindings/gpio/gpio.h"
#include "include/dt-bindings/pinctrl/pinctrl-zynqmp.h"
#include "include/dt-bindings/input/input.h"
#include "include/dt-bindings/interrupt-controller/irq.h"
#include "include/dt-bindings/power/xlnx-zynqmp-power.h"
#include "include/dt-bindings/reset/xlnx-zynqmp-resets.h"

/ {
	model = "Microphase Z7-Lite";
	compatible = "microphase,z7-lite", "xlnx,zynq-7000";
	
	chosen {
		bootargs = "earlycon console=ttyPS0,115200 clk_ignore_unused root=/dev/mmcblk0p2 ro rootwait";
		stdout-path = "serial0:115200n8";
	};
	
	/delete-node/ aliases ;
	aliases {
		ethernet0 = &gem0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		serial0 = &uart0;
		serial1 = &uart1;
		spi0 = &qspi;
		spi1 = &spi0;
		gpio0 = &gpio0;
		gpio1 = &axi_gpio_0;
	};

	gpio-leds {
		compatible = "gpio-leds";

		ps-led-0 {
			label = "ps-led-0";
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		pl-led-0 {
			label = "pl-led-0";
			gpios = <&gpio0 56 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		pl-led-1 {
			label = "pl-led-1";
			gpios = <&gpio0 57 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
	
	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		ps-button-0 {
			label = "ps-button-0";
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			debounce-interval = <70>;
			wakeup-source;
			autorepeat;
		};

		pl-button-0 {
			label = "pl-button-0";
			gpios = <&gpio0 54 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			debounce-interval = <70>;
			autorepeat;
		};

		pl-button-1 {
			label = "pl-button-1";
			gpios = <&gpio0 55 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_2>;
			debounce-interval = <70>;
		};
	};
	
	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = 
			<&adc 0>,           /* temperature (channel 0) */
			<&adc 1>,           /* vccint */
			<&adc 2>,           /* vccaux */
			<&adc 3>;           /* vccbram */
	};
	
	usb_phy0: usb_phy@0 {
		compatible = "ulpi-phy";
		#phy-cells = <0>;
		reg = <0xe0002000 0x1000>;
		view-port = <0x0170>;
		drv-vbus;
	};
};

&pinctrl0 {
	usb_phy0_reset_pin: usb-phy0-reset-pin {
		mux {
			groups = "gpio0_46_grp";
			function = "gpio0";
		};

		conf {
			groups = "gpio0_46_grp";
			slew-rate = <0>;
			io-standard = <3>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "host";
	usb-phy = <&usb_phy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&usb_phy0_reset_pin>;
};

&adc {
	status = "okay";
	#io-channel-cells = <1>;
};

&gem0 {
	status = "okay";
	phy-mode = "gmii";
	phy-handle = <&gem0_phy>;
	local-mac-address = [d8 cb 3a 39 d5 24];

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		
		gem0_phy: ethernet-phy@1 {
			compatible = "realtek,rtl8201f", "realtek,rtl8201", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			reg = <1>;
			reset-gpios = <&gpio0 58 GPIO_ACTIVE_LOW>;
            reset-assert-us = <10000>;
            reset-deassert-us = <30000>;
			max-speed = <100>;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	rtc@68 {
		compatible = "nxp,pcf8523";
		reg = <0x68>;
		interrupt-parent = <&gpio0>;
		interrupts = <59 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
	
	ccs811@5a {
		compatible = "ams,ccs811";
		reg = <0x5a>;
		reset-gpios = <&axi_gpio_0 0 GPIO_ACTIVE_LOW>;
		wakeup-gpios = <&axi_gpio_0 1 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&axi_gpio_0>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
	};
	
	sht41@44 {
		compatible = "sensirion,sht4x";
		reg = <0x44>;
	};
	
	apds9960@39 {
		compatible = "avago,apds9960";
		reg = <0x39>;

		interrupt-parent = <&axi_gpio_0>;
		interrupts = <3 IRQ_TYPE_EDGE_RISING>;
	};
};

&spi0 {
	status = "okay";
	is-decoded-cs = <0>;
	num-cs = <3>;
	
	spidev@0 {
		compatible = "xlnx,generic";
		reg = <0>;
		spi-max-frequency = <10000000>;
		/* spi-cpol; */
		/* spi-cpha; */
	};
	
	spidev@1 {
		compatible = "xlnx,generic";
		reg = <1>;
		spi-max-frequency = <10000000>;
		/* spi-cpol; */
		/* spi-cpha; */
	};
	
	spidev@2 {
		compatible = "xlnx,generic";
		reg = <2>;
		spi-max-frequency = <10000000>;
		/* spi-cpol; */
		/* spi-cpha; */
	};
};

&qspi {
	status = "okay";
	is-dual = <0>;
	num-cs = <1>;
	
	spi-nor@0 {
		compatible = "winbond,w25q128", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&sdhci0 {
	status = "okay";
	max-frequency = <50000000>;
	disable-wp;
	no-1-8-v;
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&xadc_wiz_0 {
    status = "okay";
};

&axi_gpio_0 {
	status = "okay";
};

&ttc0 {
	status = "okay";
	#pwm-cells = <3>;
};
