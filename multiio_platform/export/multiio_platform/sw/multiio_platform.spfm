<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="multiio_platform"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
multiio_platform
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="multiio_platform">
        <sdx:configuration sdx:name="multiio_platform"
                           sdx:displayName="multiio_platform"
                           sdx:defaultProcessorGroup="cortexa9_1_domain"
                           sdx:runtimes="cpp">
            <sdx:description>multiio_platform</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif=""
                            sdx:imageData=""
                            sdx:readme="multiio_platform/boot/generic.readme"
                            sdx:qemuArguments="multiio_platform/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="cortexa9_0_domain"
                            sdx:bif="multiio_platform/boot/multiio_platform.bif"
                            sdx:readme="multiio_platform/boot/generic.readme"
                            sdx:qemuArguments="multiio_platform/cortexa9_0_domain/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="cortexa9_1_domain"
                            sdx:bif="multiio_platform/boot/multiio_platform.bif"
                            sdx:readme="multiio_platform/boot/generic.readme"
                            sdx:qemuArguments="multiio_platform/cortexa9_1_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="cortexa9_0_domain"
                                sdx:displayName="cortexa9_0_domain"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="multiio_platform/cortexa9_0_domain/bsplib/lib"
                        sdx:bspIncludePaths="multiio_platform/cortexa9_0_domain/bspinclude/include"
                        sdx:bspConfig="multiio_platform/cortexa9_0_domain/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="cortexa9_1_domain"
                                sdx:displayName="cortexa9_1_domain"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_1">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="multiio_platform/cortexa9_1_domain/bsplib/lib"
                        sdx:bspIncludePaths="multiio_platform/cortexa9_1_domain/bspinclude/include"
                        sdx:bspConfig="multiio_platform/cortexa9_1_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
